# .env.example — скопируйте в .env и заполните своими значениями

# ── Telegram ──────────────────────────────────────────────────────────────────
BOT_TOKEN=your_bot_token_here

# Список ID администраторов через запятую
ADMIN_IDS=123456789,987654321

# ID главного HR-чата (куда приходят анкеты)
ADMIN_CHAT_ID=123456789

# ── База данных ───────────────────────────────────────────────────────────────
# SQLite (по умолчанию, для локального запуска):
DATABASE_URL=sqlite+aiosqlite:///database.db
# Postgres (для docker-compose):
# DATABASE_URL=postgresql+asyncpg://mado:mado_password@postgres:5432/mado_db

# ── Google Sheets ─────────────────────────────────────────────────────────────
GOOGLE_SHEET_NAME=Анкеты MADO
CREDENTIALS_PATH=credentials.json
SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit

# ── Обязательная подписка на канал (оставить пустым если не нужно) ────────────
REQUIRED_CHANNEL=

# ── Хранилище FSM ─────────────────────────────────────────────────────────────
FSM_STORAGE_PATH=fsm_storage.db

# ── Логирование ───────────────────────────────────────────────────────────────
# Путь к лог-файлу (папка создаётся автоматически)
LOG_PATH=logs/bot.log

# Уровень логирования: DEBUG | INFO | WARNING | ERROR | CRITICAL
# WARNING — рекомендуется для production
LOG_LEVEL=WARNING
