# .env.example — скопируйте в .env и заполните своими значениями

# ── Telegram ──────────────────────────────────────────────────────────────────
BOT_TOKEN=your_bot_token_here

# Список ID администраторов через запятую
ADMIN_IDS=123456789,987654321

# ID главного HR-чата (куда приходят анкеты)
ADMIN_CHAT_ID=123456789

# ── База данных ───────────────────────────────────────────────────────────────
# SQLite (по умолчанию):
DATABASE_URL=sqlite+aiosqlite:///database.db
# Если нужен Postgres (установите asyncpg):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ── Google Sheets ─────────────────────────────────────────────────────────────
GOOGLE_SHEET_NAME=Анкеты MADO
CREDENTIALS_PATH=credentials.json
SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit

# ── Обязательная подписка на канал (оставить пустым если не нужно) ────────────
REQUIRED_CHANNEL=

# ── Хранилище FSM ─────────────────────────────────────────────────────────────
FSM_STORAGE_PATH=fsm_storage.db

# ── Логирование ───────────────────────────────────────────────────────────────
# Путь к лог-файлу (папка создаётся автоматически)
LOG_PATH=logs/bot.log

# Уровень логирования: DEBUG | INFO | WARNING | ERROR | CRITICAL
# WARNING — рекомендуется для production
LOG_LEVEL=WARNING

# ── OpenAI API (AI-интервью и скрининг кандидатов) ───────────────────────────
# Получить ключ: https://platform.openai.com/api-keys
# Оставить пустым — AI-скрининг отключится, бот будет работать как раньше
OPENAI_API_KEY=

# Включить/выключить AI-скрининг: true | false
AI_SCREENING_ENABLED=true

# ── Cloudflare Workers AI (устарело, больше не используется) ─────────────────
# Оставлены для обратной совместимости, можно удалить
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
